{
  "name": "obsidian-cleanview",
  "version": "0.1.0",
  "description": "Fast, fully local dashboards for Obsidian",
  "license": "MIT",
  "author": "Sjef200",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "npm run test:build && node .test-build.mjs",
    "test:build": "esbuild test/run.ts --bundle --platform=node --format=esm --external:obsidian --outfile=.test-build.mjs --log-level=error",
    "preview:build": "esbuild preview/entry.ts --bundle --format=esm --alias:obsidian=./preview/obsidian-stub.ts --outfile=preview/bundle.js --log-level=error",
    "preview": "npm run preview:build && python3 -m http.server 4599"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2"
  }
}
